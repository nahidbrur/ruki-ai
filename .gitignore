# --- Secrets: API keys live in .env (.env.example is the template that is committed) ---
.env
.env.*
!.env.example
llm_settings.json

# --- Large model files (~1.5 GB; see README "Models" for where they come from) ---
# Small files next to them stay tracked: licenses, NOTICE, keep_ids.json, tokenizer_config.json, the build patch.
models/**/*.onnx
models/**/*.onnx_data
models/**/*.npy
models/**/*.gguf
models/**/*.so*
models/asr/hima-asr-onnx/tokenizer.json

# --- Voices cloned from the web UI (personal recordings) ---
voices/user/

# --- Generated audio and logs ---
outputs/
*.log

