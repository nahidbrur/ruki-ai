# Copy to .env and fill in. Only GEMINI_API_KEY is required.

# --- LLM: Gemini ---
# One key, or several as a JSON list / comma-separated (the next key is used on quota or auth errors)
GEMINI_API_KEYS=["key-1", "key-2"]
# GEMINI_API_KEY=single-key   (also accepted)
# Any model your key can use; list them with: python scripts/check_gemini.py
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high  (minimal = lowest latency; 2.5 models get thinking budget 0)
GEMINI_THINKING=minimal
GEMINI_MAX_TOKENS=512
MAX_HISTORY_TURNS=12
# SYSTEM_PROMPT=...   (default: Ruki, a concise Bangla voice assistant; see banglavoice/config.py)
# Spoken as soon as the microphone is turned on; set it empty (WELCOME_MESSAGE=) for no greeting
# WELCOME_MESSAGE=আচ্ছালামু আলাইকুম! আমি রুকি। বলুন, আপনাকে কীভাবে সাহায্য করতে পারি?

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- ASR: Hima-ASR int8 on CPU ---
ASR_THREADS=6
ASR_LANGUAGE=bn

# --- Turn taking ---
VAD_THRESHOLD=0.5
# silence that ends your turn; lower = snappier replies, higher = fewer cut-offs mid-sentence
VAD_MIN_SILENCE_MS=600
VAD_MIN_SPEECH_MS=300
DENOISE=true
ALLOW_INTERRUPTIONS=true
BARGE_IN_MIN_MS=350
BARGE_IN_THRESHOLD=0.7

# --- TTS: OmniVoice on the RTX 2050 (Vulkan1); Vulkan0 = Intel iGPU, CPU = very slow ---
TTS_DEVICE=Vulkan1
# 8 fastest, 16 balanced, 32 best quality
TTS_STEPS=16
# steps for the first TTS_FAST_CHUNKS chunks of each reply (they set the time to first audio and the
# pause after the first sentence); 12 is ~25% faster than 16
TTS_FIRST_STEPS=12
TTS_FAST_CHUNKS=2
TTS_CHUNK_SEC=4.0
DEFAULT_VOICE=speaker_1
# first reply chunk may end at a comma once this long (time to first audio ~ length of the first chunk)
FIRST_CHUNK_MIN_CHARS=15
TTS_MAX_CHARS=220

# --- Logging ---
# DEBUG | INFO | WARNING. DEBUG also shows each turn's latency breakdown (voice-to-voice, ASR, LLM, TTS)
# and the model names in the web UI; any other level hides them.
LOG_LEVEL=INFO
